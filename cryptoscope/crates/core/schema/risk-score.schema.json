{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptoscope.dev/schema/0.1.0/risk-score.schema.json",
  "title": "RiskScore",
  "description": "5-axis additive QuantumRiskScore (D-10).",
  "type": "object",
  "properties": {
    "algorithmVulnerability": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "AlgorithmVulnerability axis score."
    },
    "usageContext": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "UsageContext axis score."
    },
    "dataShelfLife": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "DataShelfLife axis score."
    },
    "exposure": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Exposure axis score."
    },
    "detectionConfidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "DetectionConfidence axis score."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Sum of all five axes, capped at 100."
    },
    "severity": {
      "type": "string",
      "description": "Severity band mapped from total score.",
      "enum": ["Critical", "High", "Medium", "Low", "Safe"]
    }
  },
  "required": [
    "algorithmVulnerability",
    "usageContext",
    "dataShelfLife",
    "exposure",
    "detectionConfidence",
    "total",
    "severity"
  ],
  "additionalProperties": false
}
