{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptoscope.dev/schema/0.1.0/scan-result.schema.json",
  "title": "ScanResult",
  "description": "Full result set from a completed cryptoscope scan, with cursor pagination (SEP-1686).",
  "type": "object",
  "properties": {
    "scanId": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4 identifying this scan run."
    },
    "schemaVersion": {
      "type": "string",
      "description": "Schema version string (semver).",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the scan started."
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the scan completed."
    },
    "target": {
      "type": "object",
      "description": "What was scanned.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["source", "certs", "deps", "network"],
          "description": "Scan kind."
        },
        "path": {
          "type": "string",
          "description": "Path or host:port that was scanned.",
          "minLength": 1
        },
        "certsHost": {
          "type": "string",
          "description": "Hostname for certificate scans (added per gap 5).",
          "minLength": 1
        }
      },
      "required": ["kind", "path"],
      "additionalProperties": false
    },
    "policyName": {
      "type": "string",
      "description": "Name of the policy applied during this scan.",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "description": "Findings in the current page.",
      "items": {
        "$ref": "https://cryptoscope.dev/schema/0.1.0/finding.schema.json"
      }
    },
    "totalFindings": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of findings across all pages."
    },
    "cursor": {
      "type": "string",
      "description": "Opaque cursor for the next page (SEP-1686 pagination). Absent when no further pages exist.",
      "minLength": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "Maximum findings per page requested."
    },
    "summary": {
      "type": "object",
      "description": "Aggregate counts per severity band.",
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high":     { "type": "integer", "minimum": 0 },
        "medium":   { "type": "integer", "minimum": 0 },
        "low":      { "type": "integer", "minimum": 0 },
        "safe":     { "type": "integer", "minimum": 0 }
      },
      "required": ["critical", "high", "medium", "low", "safe"],
      "additionalProperties": false
    }
  },
  "required": [
    "scanId",
    "schemaVersion",
    "startedAt",
    "completedAt",
    "target",
    "policyName",
    "findings",
    "totalFindings",
    "summary"
  ],
  "additionalProperties": false
}
