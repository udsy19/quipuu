{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptoscope.dev/schema/0.1.0/policy.schema.json",
  "title": "Policy",
  "description": "Cryptoscope scan policy (NIST IR 8547 IPD defaults + QuantumRiskScore weights).",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "notes": { "type": "string" }
      },
      "required": ["name", "displayName", "sourceUrl"],
      "additionalProperties": false
    },
    "deprecation": {
      "type": "object",
      "properties": {
        "asymmetric112bitDeprecatedAfter": { "type": "integer", "minimum": 2000 },
        "asymmetric112bitDisallowedAfter": { "type": "integer", "minimum": 2000 },
        "asymmetric128bitPlusDisallowedAfter": { "type": "integer", "minimum": 2000 },
        "aes128Acceptable": { "type": "boolean" },
        "aes192Acceptable": { "type": "boolean" },
        "aes256Acceptable": { "type": "boolean" },
        "sha256Acceptable": { "type": "boolean" },
        "sha384Acceptable": { "type": "boolean" },
        "sha512Acceptable": { "type": "boolean" },
        "classicallyBroken": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "asymmetric112bitDeprecatedAfter",
        "asymmetric112bitDisallowedAfter",
        "asymmetric128bitPlusDisallowedAfter",
        "aes128Acceptable",
        "aes192Acceptable",
        "aes256Acceptable",
        "sha256Acceptable",
        "sha384Acceptable",
        "sha512Acceptable",
        "classicallyBroken"
      ],
      "additionalProperties": false
    },
    "riskWeights": {
      "type": "object",
      "properties": {
        "algorithmVulnerability": { "type": "integer", "minimum": 0, "maximum": 100 },
        "usageContext":           { "type": "integer", "minimum": 0, "maximum": 100 },
        "dataShelfLife":          { "type": "integer", "minimum": 0, "maximum": 100 },
        "exposure":               { "type": "integer", "minimum": 0, "maximum": 100 },
        "detectionConfidence":    { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": [
        "algorithmVulnerability",
        "usageContext",
        "dataShelfLife",
        "exposure",
        "detectionConfidence"
      ],
      "additionalProperties": false
    },
    "algorithmVulnerability": {
      "type": "object",
      "description": "Map from QuantumStatus to score weight.",
      "propertyNames": {
        "enum": [
          "BrokenClassically",
          "BrokenByShor",
          "WeakenedByGrover",
          "QuantumSafe",
          "PqcFinal",
          "PqcDraft"
        ]
      },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 100 }
    },
    "usageContextWeights": {
      "type": "object",
      "properties": {
        "keyEstablishmentLongLived":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "keyEstablishmentEphemeral":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "dataAtRestEncryption":        { "type": "integer", "minimum": 0, "maximum": 100 },
        "signatureLongLived":          { "type": "integer", "minimum": 0, "maximum": 100 },
        "signatureEphemeral":          { "type": "integer", "minimum": 0, "maximum": 100 },
        "authenticationOnly":          { "type": "integer", "minimum": 0, "maximum": 100 },
        "hashing":                     { "type": "integer", "minimum": 0, "maximum": 100 },
        "unknown":                     { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": [
        "keyEstablishmentLongLived",
        "keyEstablishmentEphemeral",
        "dataAtRestEncryption",
        "signatureLongLived",
        "signatureEphemeral",
        "authenticationOnly",
        "hashing",
        "unknown"
      ],
      "additionalProperties": false
    },
    "dataShelfLife": {
      "type": "object",
      "properties": {
        "ephemeral": { "type": "integer", "minimum": 0, "maximum": 100 },
        "short":     { "type": "integer", "minimum": 0, "maximum": 100 },
        "medium":    { "type": "integer", "minimum": 0, "maximum": 100 },
        "long":      { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["ephemeral", "short", "medium", "long"],
      "additionalProperties": false
    },
    "exposure": {
      "type": "object",
      "properties": {
        "publicInternet":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "internalService":  { "type": "integer", "minimum": 0, "maximum": 100 },
        "localOnly":        { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["publicInternet", "internalService", "localOnly"],
      "additionalProperties": false
    },
    "detectionConfidence": {
      "type": "object",
      "properties": {
        "literalArg":    { "type": "integer", "minimum": 0, "maximum": 100 },
        "typeName":      { "type": "integer", "minimum": 0, "maximum": 100 },
        "variable":      { "type": "integer", "minimum": 0, "maximum": 100 },
        "stringTable":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "unknown":       { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["literalArg", "typeName", "variable", "stringTable", "unknown"],
      "additionalProperties": false
    },
    "severityBands": {
      "type": "object",
      "properties": {
        "critical": { "type": "integer", "minimum": 0, "maximum": 100 },
        "high":     { "type": "integer", "minimum": 0, "maximum": 100 },
        "medium":   { "type": "integer", "minimum": 0, "maximum": 100 },
        "low":      { "type": "integer", "minimum": 0, "maximum": 100 },
        "safe":     { "type": "integer", "minimum": 0, "maximum": 100 }
      },
      "required": ["critical", "high", "medium", "low", "safe"],
      "additionalProperties": false
    },
    "hndlFlag": {
      "type": "object",
      "properties": {
        "requireQuantumStatusIn": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BrokenClassically",
              "BrokenByShor",
              "WeakenedByGrover",
              "QuantumSafe",
              "PqcFinal",
              "PqcDraft"
            ]
          }
        },
        "requireUsageContextIn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requireMinShelfLifeBucket": {
          "type": "string",
          "enum": ["ephemeral", "short", "medium", "long"]
        }
      },
      "required": [
        "requireQuantumStatusIn",
        "requireUsageContextIn",
        "requireMinShelfLifeBucket"
      ],
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "failOn": {
          "type": "string",
          "enum": ["Critical", "High", "Medium", "Low", "Safe"]
        }
      },
      "required": ["failOn"],
      "additionalProperties": false
    }
  },
  "required": [
    "meta",
    "deprecation",
    "riskWeights",
    "algorithmVulnerability",
    "usageContextWeights",
    "dataShelfLife",
    "exposure",
    "detectionConfidence",
    "severityBands",
    "hndlFlag",
    "ci"
  ],
  "additionalProperties": false
}
